{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/catalogue/:path*",
      "destination": "https://chadrey-wholesale.femiolaniyi36.workers.dev/api/catalogue/:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "https://chadrey-wholesale.femiolaniyi36.workers.dev/api/admin/:path*"
    },
    {
      "source": "/photos/:path*",
      "destination": "https://chadrey-wholesale.femiolaniyi36.workers.dev/photos/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
